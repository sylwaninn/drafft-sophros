# Secrets for `pnpm dev` (copy to .dev.vars and fill in by hand). The dev server works against the staging project.
# The staging project's secret key (Supabase dashboard, staging project, API keys).
SUPABASE_SECRET_KEY=
# Stream staging app.
STREAM_API_KEY=
STREAM_API_SECRET=
# AUTH_MODE=dev only: who you are on the dev server. Must be in staging's private.staff.
DEV_STAFF_EMAIL=
